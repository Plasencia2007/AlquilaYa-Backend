# ==============================================================
# AlquilaYa — Plantilla de variables de entorno
# ==============================================================
# Copia este archivo a .env y reemplaza los valores placeholder
# por los reales. El archivo .env NUNCA se sube a git.
# ==============================================================

# --- Bases de datos (solo locales con docker) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-por-password-seguro
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# BD dedicada del chat in-app. Inicializada por database/init.sql.
POSTGRES_DB_MENSAJERIA=alquilaya_mensajeria
MYSQL_USER=root
MYSQL_PASSWORD=cambiar-por-password-seguro
MYSQL_HOST=localhost
MYSQL_PORT=3307

# --- Infraestructura Spring Cloud ---
# Eureka y el Config Server exigen Basic Auth (sin esto, cualquiera en la red podía
# leer /eureka/apps o los secretos ya resueltos de cada servicio via config-server).
# EUREKA_USERNAME/PASSWORD deben ir EMBEBIDOS en EUREKA_DEFAULT_ZONE (es el mecanismo
# estándar de Spring Cloud Netflix: http://user:pass@host:8761/eureka/) — si cambias
# las credenciales, actualiza los dos lugares.
EUREKA_USERNAME=eureka-admin
EUREKA_PASSWORD=cambiar-por-password-seguro
# En docker-compose/k8s reemplazar host:puerto por el nombre de servicio (p.ej. discovery-server:8761)
EUREKA_DEFAULT_ZONE=http://eureka-admin:cambiar-por-password-seguro@localhost:8761/eureka/
CONFIG_SERVER_USERNAME=config-admin
CONFIG_SERVER_PASSWORD=cambiar-por-password-seguro
SPRING_CLOUD_CONFIG_URI=http://localhost:8888
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Redis (cache compartido entre microservicios; aislamiento por prefijo de key) ---
# Standalone (no cluster). En docker-compose el host es "redis"; corriendo Spring
# en host (mvn spring-boot:run) usar "localhost" porque el contenedor expone 6379.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis-secret-2026-change-me-please

# --- CORS ---
# Lista separada por comas; admite patrones (p.ej. https://*.alquilaya.com). "*" NO es válido si allow-credentials=true.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- JWT (debe ser la misma en usuarios, propiedades, pagos y catalogos) ---
JWT_SECRET=cambiar-por-secreto-aleatorio-de-al-menos-256-bits
# 2h en ms. Para prod se recomienda ≤ 1h (3600000) + refresh tokens.
JWT_EXPIRATION=7200000

# --- Primer admin (bootstrap) ---
# Solo se usa en un despliegue NUEVO: si la BD no tiene ningún ADMIN, se crea uno con estas
# credenciales (la contraseña se hashea en runtime, no se guarda en claro). En dev déjalo vacío
# si ya tienes admin. En prod usa una contraseña fuerte y distinta.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Cloudinary (https://cloudinary.com/console) ---
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# --- Mercado Pago (https://www.mercadopago.com.pe/developers/panel/app) ---
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxx
# Secret para validar firma del webhook (panel MP > Webhooks > "Clave secreta")
# En producción DEBE estar seteado.
MP_WEBHOOK_SECRET=
# DEV: en false el webhook se acepta sin firma (necesario si MP_WEBHOOK_SECRET está vacío).
# PROD: true (o quitar) + MP_WEBHOOK_SECRET configurado.
MP_WEBHOOK_REQUIRED_SIGNATURE=false
MP_NOTIFICATION_URL=https://tu-tunel.ngrok-free.dev/api/v1/pagos/webhook
# URLs de retorno post-pago (producción debe apuntar al dominio real)
MP_BACK_URL_SUCCESS=http://localhost:3000/pago/exito
MP_BACK_URL_FAILURE=http://localhost:3000/pago/fallo
MP_BACK_URL_PENDING=http://localhost:3000/pago/pendiente

# --- Frontend: simulador de pago dev (ítem 282) ---
# Habilita en el frontend el botón "Simular pago exitoso (dev)" (PaymentFlowDialog), que llama
# a POST /pagos/simular-exito/{reservaId} (DevOnlyPagoController, @Profile("!prod") en el
# backend). Además del gate por NODE_ENV, esta variable evita que el botón aparezca por
# accidente en demos o previews públicas. Dejar en "false" (o vacío) salvo en dev local.
NEXT_PUBLIC_ENABLE_DEV_PAY=false

# --- ngrok (https://dashboard.ngrok.com/get-started/your-authtoken) ---
NGROK_AUTHTOKEN=tu-authtoken-aqui
NGROK_DOMAIN=tu-dominio.ngrok-free.dev

# --- Notificaciones (servicio Node.js) ---
# Secret compartido entre los servicios Java y el servicio Node.
# Cualquier llamada HTTP a /api/v1/notifications/whatsapp/* exige header x-api-key con este valor.
# Generar con: openssl rand -hex 32
INTERNAL_API_KEY=cambiar-por-secreto-aleatorio-de-32-bytes
NOTIFICATION_SERVICE_URL=http://localhost:8081

# --- Frontend: métricas de red del panel admin (opcional) ---
# URL server-side (no expuesta al navegador) que usa `api/admin/network-metrics` para
# consultar Prometheus. Stack opcional y separado (docker-compose.observability.yml,
# puerto 9090) — si no está levantado, el panel degrada solo mostrando un aviso, sin
# datos mock ni error roto.
PROMETHEUS_URL=http://localhost:9090

# --- Hibernate / JPA ---
# En producción usar "validate" (requiere migraciones Flyway) o "none". Nunca "update" en prod.
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false

# --- Reservas: expiración por falta de pago (servicio-propiedades) ---
# Horas que una reserva APROBADA espera el pago antes de pasar a EXPIRADA y liberar el cuarto.
RESERVA_EXPIRACION_HORAS=24
# Cron del job que expira reservas sin pago (default: cada hora en punto).
RESERVA_EXPIRACION_CRON=0 0 */1 * * *
# Cron del job que finaliza reservas PAGADA con estadía vencida (default: diario 00:30).
RESERVA_FINALIZACION_CRON=0 30 0 * * *
# Recordatorio de pago: fracción del plazo consumida tras la cual se avisa (0.5 = a mitad).
RESERVA_RECORDATORIO_FRACCION=0.5
# Cron del job de recordatorios de pago (default: cada 30 minutos).
RESERVA_RECORDATORIO_CRON=0 */30 * * * *

# --- Gmail SMTP (forgot-password) ---
# Cuenta Gmail real con 2FA habilitado + App Password de 16 chars (sin espacios).
# Generar app password: Google Account → Security → App passwords → "Mail" + "Otro: AlquilaYa".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# --- URL del frontend (para construir links de reset password en emails) ---
APP_BASE_URL=http://localhost:3000

# --- Google OAuth (login con Google) ---
# Crear OAuth Client ID Web en https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=

# --- Cloudflare Turnstile (anti-bots en register/forgot-password/resend-otp) ---
# Crear site en https://dash.cloudflare.com/ → Turnstile → Add Site
# Domain: localhost
# NEXT_PUBLIC_ porque el sitekey lo lee el navegador (TurnstileWidget); el secret NUNCA
# lleva ese prefijo — solo lo usa servicio-usuarios (TurnstileService) server-side.
# Sin TURNSTILE_SECRET_KEY configurada, la verificación degrada a "permitir siempre"
# (con WARN en logs) — no hace falta CAPTCHA_ENABLED aparte, la key configurada ya es el switch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Apiperu.dev ---
APIPERU_TOKEN=
